rules_version = '2';

// This project uses Firebase Realtime Database (database.rules.json) rather than Cloud Firestore.
// Deny all Firestore access by default so no unused database can ever be exposed in test mode.
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
